PORT=3333

# Em produção com docker-compose.prod.yml, o host do Postgres é "db" (nome do
# serviço), não "localhost". Usuário/senha devem bater com o .env da raiz do projeto.
DATABASE_URL="postgresql://maismoney:maismoney@localhost:5432/maismoney_inbox?schema=public"

# PRODUÇÃO: gere um valor novo e forte, nunca reaproveite o de dev.
# Sugestão: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-por-um-segredo-forte-antes-de-ir-para-producao"
JWT_EXPIRES_IN="8h"

# PRODUÇÃO: URL do frontend publicado (ex. https://inbox.maismoney.com.br), sem barra no final.
CORS_ORIGIN="http://localhost:5173"

# URL pública do próprio backend — usada para montar a URL assinada de mídia que a
# Evolution API / Meta Cloud API buscam. PRODUÇÃO: https://seu-dominio.com/api
PUBLIC_API_URL="http://localhost:3333"

# usados apenas pelo script de seed (cria o primeiro usuario admin)
ADMIN_NOME="Admin"
ADMIN_EMAIL="admin@maismoney.com.br"
ADMIN_SENHA="troque-esta-senha"

# Evolution API (self-hosted via Docker) — numeros de atendimento receptivo.
# Em produção com docker-compose.prod.yml, o host é "evolution-api", não "localhost".
EVOLUTION_API_URL="http://localhost:8080"
EVOLUTION_API_KEY=""

# Meta Cloud API (oficial) — numeros de disparo
META_ACCESS_TOKEN=""
META_WEBHOOK_VERIFY_TOKEN="troque-por-um-valor-secreto"
META_APP_SECRET=""
META_API_VERSION="v21.0"

# Deleção automática de mídia (regra dos 4 dias, secão 7 do CLAUDE.md)
MEDIA_RETENTION_DIAS=4
UPLOADS_DIR="uploads"

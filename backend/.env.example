PORT=3333

# Em produção com docker-compose.prod.yml, o host do Postgres é "db" (nome do
# serviço), não "localhost". Usuário/senha devem bater com o .env da raiz do projeto.
DATABASE_URL="postgresql://maismoney:maismoney@localhost:5432/maismoney_inbox?schema=public"

# PRODUÇÃO: gere um valor novo e forte, nunca reaproveite o de dev.
# Sugestão: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-por-um-segredo-forte-antes-de-ir-para-producao"
JWT_EXPIRES_IN="8h"

# PRODUÇÃO: URL do frontend publicado (ex. https://inbox.maismoney.com.br), sem barra no final.
CORS_ORIGIN="http://localhost:5173"

# URL pública do próprio backend — usada para montar a URL assinada de mídia que a
# Evolution API / Meta Cloud API buscam. PRODUÇÃO: https://seu-dominio.com/api
PUBLIC_API_URL="http://localhost:3333"

# usados apenas pelo script de seed (cria o primeiro usuario admin)
ADMIN_NOME="Admin"
ADMIN_EMAIL="admin@maismoney.com.br"
ADMIN_SENHA="troque-esta-senha"

# Evolution API (self-hosted via Docker) — numeros de atendimento receptivo.
# Em produção com docker-compose.prod.yml, o host é "evolution-api", não "localhost".
EVOLUTION_API_URL="http://localhost:8080"
EVOLUTION_API_KEY=""
# Segredo do webhook Evolution. Gere com: openssl rand -hex 32
# Ver DEPLOY.md antes de definir em produção (precisa sincronizar as instâncias antes).
EVOLUTION_WEBHOOK_TOKEN=""

# Meta Cloud API (oficial) — numeros de disparo
META_ACCESS_TOKEN=""
META_WEBHOOK_VERIFY_TOKEN="troque-por-um-valor-secreto"
META_APP_SECRET=""
META_API_VERSION="v21.0"

# Deleção automática de mídia (regra dos 4 dias, secão 7 do CLAUDE.md)
MEDIA_RETENTION_DIAS=4
UPLOADS_DIR="uploads"

# Discadora (Fase 2) — Twilio Voice + IVR
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
# Em produção com docker-compose.prod.yml, o host é "redis", não "localhost".
REDIS_URL="redis://localhost:6379"

# Maisa (IA de atendimento). Deixe desligado em produção até a liberação.
# desligado | copiloto (ela sugere, a equipe envia) | automatico (ela envia)
MAISA_MODO=desligado
# true só para teste: simulações usam um banco de mentira, com ofertas fictícias
MAISA_BANCO_SIMULADO=false
# API da Facta para a simulação CLT. Comece pela homologação.
# Produção (https://webservice.facta.com.br) só responde do IP liberado na Facta.
# Com MAISA_BANCO_SIMULADO=true a Facta não é chamada.
FACTA_BASE_URL=https://webservice-homol.facta.com.br
FACTA_USER=
FACTA_PASS=
# true só no ambiente local: libera "Testar Maisa", com clientes de mentira
MAISA_SIMULADOR=false

# OpenAI. Leitura de extrato de INSS/SIAPE usa um modelo com visao.
OPENAI_API_KEY=
OPENAI_MODELO_EXTRATO=gpt-6.1-sol
OPENAI_MODELO_AUDIO=gpt-4o-transcribe

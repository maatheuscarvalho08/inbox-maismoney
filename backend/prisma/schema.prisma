generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  operador
}

enum TipoConexao {
  evolution
  meta_cloud
}

enum StatusInstancia {
  conectado
  desconectado
}

enum StatusConversa {
  aberta
  em_atendimento
  aguardando
  encerrada
}

enum RemetenteTipo {
  cliente
  operador
}

enum StatusEntrega {
  enviado
  entregue
  lido
  falhou
}

enum StatusCampanha {
  rascunho
  em_andamento
  pausada
  concluida
}

enum StatusLigacao {
  pendente
  discando
  atendeu
  nao_atendeu
  ocupado
  erro
}

model Usuario {
  id         String   @id @default(uuid())
  nome       String
  email      String   @unique
  senhaHash  String   @map("senha_hash")
  role       Role
  ativo      Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")

  conversas  Conversa[]  @relation("OperadorConversas")
  mensagens  Mensagem[]  @relation("OperadorMensagens")
  campanhas  CampanhaDiscadora[]

  @@map("usuarios")
}

model Instancia {
  id                 String           @id @default(uuid())
  nome               String
  numero             String           @unique
  tipoConexao        TipoConexao      @map("tipo_conexao")
  evolutionInstanceId String?         @map("evolution_instance_id")
  metaPhoneNumberId  String?          @map("meta_phone_number_id")
  metaWabaId         String?          @map("meta_waba_id")
  status             StatusInstancia  @default(desconectado)
  createdAt          DateTime         @default(now()) @map("created_at")

  templates          Template[]
  conversas          Conversa[]
  campanhas          CampanhaDiscadora[]

  @@map("instancias")
}

model Template {
  id              String   @id @default(uuid())
  instanciaId     String   @map("instancia_id")
  nome            String
  metaTemplateId  String   @map("meta_template_id")
  idioma          String   @default("pt_BR")
  // Texto real do corpo aprovado na Meta (com {{1}}, {{2}}...) — usado pra mostrar a
  // mensagem de verdade no histórico de disparos, em vez de só o nome do template.
  corpo           String?
  variaveisSchema Json?    @map("variaveis_schema")
  createdAt       DateTime @default(now()) @map("created_at")

  instancia       Instancia @relation(fields: [instanciaId], references: [id])
  campanhas       CampanhaDiscadora[]

  @@map("templates")
}

model Contato {
  id             String   @id @default(uuid())
  nome           String?
  cpf            String?
  numeroWhatsapp String   @unique @map("numero_whatsapp")
  createdAt      DateTime @default(now()) @map("created_at")

  conversas      Conversa[]

  @@map("contatos")
}

model Conversa {
  id            String          @id @default(uuid())
  instanciaId   String          @map("instancia_id")
  contatoId     String          @map("contato_id")
  status        StatusConversa  @default(aberta)
  operadorId    String?         @map("operador_id")
  lastMessageAt DateTime        @default(now()) @map("last_message_at")
  createdAt     DateTime        @default(now()) @map("created_at")
  // Marca permanente de que essa conversa nasceu de um disparo (nunca volta a false) —
  // usada pra exibir a etiqueta azul mesmo depois que o lead responde e vira atendimento.
  origemDisparo Boolean         @default(false) @map("origem_disparo")
  // Vira true no primeiro reply do cliente — é o que tira a conversa da aba "Disparos"
  // e joga pra aba "Atendimento" sem precisar reclassificar origemDisparo.
  respondida    Boolean         @default(true) @map("respondida")

  instancia     Instancia  @relation(fields: [instanciaId], references: [id])
  contato       Contato    @relation(fields: [contatoId], references: [id])
  operador      Usuario?   @relation("OperadorConversas", fields: [operadorId], references: [id])
  mensagens     Mensagem[]
  etiquetas     ConversaEtiqueta[]

  @@map("conversas")
}

model Etiqueta {
  id        String   @id @default(uuid())
  nome      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  conversas ConversaEtiqueta[]

  @@map("etiquetas")
}

model ConversaEtiqueta {
  conversaId String   @map("conversa_id")
  etiquetaId String   @map("etiqueta_id")
  createdAt  DateTime @default(now()) @map("created_at")

  conversa   Conversa @relation(fields: [conversaId], references: [id])
  etiqueta   Etiqueta @relation(fields: [etiquetaId], references: [id])

  @@id([conversaId, etiquetaId])
  @@map("conversa_etiquetas")
}

model Mensagem {
  id            String        @id @default(uuid())
  conversaId    String        @map("conversa_id")
  remetenteTipo RemetenteTipo @map("remetente_tipo")
  operadorId    String?       @map("operador_id")
  conteudoTexto String?       @map("conteudo_texto")
  tipoMidia     String?       @map("tipo_midia")
  midiaPath     String?       @map("midia_path")
  midiaDeleted  Boolean       @default(false) @map("midia_deleted")
  // ID da mensagem no provedor (wamid da Meta, key.id do Baileys/Evolution) — usado pra
  // não duplicar quando o webhook reentrega o mesmo evento (a Meta garante "pelo menos
  // uma vez", não "exatamente uma vez"). Nulo pra mensagens criadas pelo operador/sistema.
  externalId    String?       @unique @map("external_id")
  // Agrupa disparos enviados juntos num CSV em massa (gerado no front, um UUID por
  // lote) — sem isso, um CSV de 50 números vira 50 linhas soltas no histórico.
  loteId        String?       @map("lote_id")
  // Nome do template usado (só disparos) — guardado à parte porque conteudoTexto
  // agora é a mensagem de verdade enviada, não dá mais pra "adivinhar" o template
  // fazendo parsing do texto.
  templateNome  String?       @map("template_nome")
  // Só relevante pra mensagem enviada pelo operador — reflete o status reportado
  // pelo webhook "statuses" da Meta (sent/delivered/read/failed).
  statusEntrega StatusEntrega? @map("status_entrega")
  timestamp     DateTime      @default(now())
  createdAt     DateTime      @default(now()) @map("created_at")

  conversa      Conversa @relation(fields: [conversaId], references: [id])
  operador      Usuario? @relation("OperadorMensagens", fields: [operadorId], references: [id])

  @@map("mensagens")
}

model CampanhaDiscadora {
  id                 String          @id @default(uuid())
  nome               String
  audioPath          String          @map("audio_path")
  templateId         String          @map("template_id")
  instanciaId        String          @map("instancia_id")
  status             StatusCampanha  @default(rascunho)
  totalNumeros       Int             @default(0) @map("total_numeros")
  criadoPor          String          @map("criado_por")
  createdAt          DateTime        @default(now()) @map("created_at")

  template           Template        @relation(fields: [templateId], references: [id])
  instancia           Instancia      @relation(fields: [instanciaId], references: [id])
  criador             Usuario        @relation(fields: [criadoPor], references: [id])
  numeros             CampanhaNumero[]

  @@map("campanhas_discadora")
}

model CampanhaNumero {
  id             String        @id @default(uuid())
  campanhaId     String        @map("campanha_id")
  numeroWhatsapp String        @map("numero_whatsapp")
  nomeContato    String?       @map("nome_contato")
  statusLigacao  StatusLigacao @default(pendente) @map("status_ligacao")
  apertou1       Boolean       @default(false) @map("apertou_1")
  hsmDisparado   Boolean       @default(false) @map("hsm_disparado")
  twilioCallSid  String?       @map("twilio_call_sid")
  iniciadoEm     DateTime?     @map("iniciado_em")
  finalizadoEm   DateTime?     @map("finalizado_em")

  campanha       CampanhaDiscadora @relation(fields: [campanhaId], references: [id])

  @@map("campanha_numeros")
}

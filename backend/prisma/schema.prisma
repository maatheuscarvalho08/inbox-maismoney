generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  operador
}

enum TipoConexao {
  evolution
  meta_cloud
}

enum StatusInstancia {
  conectado
  desconectado
}

enum Convenio {
  inss
  clt
  siape
  servidor_prefeitura
  marinha
  militar
  conta_de_luz
  loas
  credito_pessoal
  fgts
}

enum EtapaFunil {
  lead
  dados_coletados
  simulacao
  simulacao_com_saldo
  proposta_digitada
  proposta_paga
}

enum ResultadoSimulacao {
  com_saldo
  sem_saldo
  erro
}

enum StatusProposta {
  digitada
  em_analise
  aprovada
  paga
  recusada
  cancelada
}

enum StatusConversa {
  aberta
  em_atendimento
  aguardando
  encerrada
}

enum RemetenteTipo {
  cliente
  operador
  maisa
  // Nota interna da Maisa para a equipe: aparece na conversa, nunca vai para o WhatsApp.
  nota
}

enum StatusEntrega {
  enviado
  entregue
  lido
  falhou
}

enum StatusCampanha {
  rascunho
  em_andamento
  pausada
  concluida
}

enum StatusLigacao {
  pendente
  discando
  atendeu
  nao_atendeu
  ocupado
  erro
}

model Usuario {
  id         String   @id @default(uuid())
  nome       String
  email      String   @unique
  senhaHash  String   @map("senha_hash")
  role       Role
  ativo      Boolean  @default(true)
  // Caminho local do avatar (upload próprio) — aparece na bolha de mensagem e no
  // topo da conversa, pra ficar mais "vivo" em vez de só a inicial do nome.
  fotoPath   String?  @map("foto_path")
  createdAt  DateTime @default(now()) @map("created_at")

  conversas  Conversa[]  @relation("OperadorConversas")
  mensagens  Mensagem[]  @relation("OperadorMensagens")
  campanhas  CampanhaDiscadora[]
  visualizacoes ConversaVisualizacao[]
  propostas  Proposta[] @relation("PropostasOperador")
  simulacoes Simulacao[] @relation("SimulacoesOperador")

  @@map("usuarios")
}

model Instancia {
  id                 String           @id @default(uuid())
  nome               String
  numero             String           @unique
  tipoConexao        TipoConexao      @map("tipo_conexao")
  evolutionInstanceId String?         @map("evolution_instance_id")
  metaPhoneNumberId  String?          @map("meta_phone_number_id")
  metaWabaId         String?          @map("meta_waba_id")
  status             StatusInstancia  @default(desconectado)
  // Liga a Maisa (IA) neste número. Conversas novas de clientes começam com ela.
  maisaAtiva         Boolean          @default(false) @map("maisa_ativa")
  createdAt          DateTime         @default(now()) @map("created_at")

  templates          Template[]
  conversas          Conversa[]
  campanhas          CampanhaDiscadora[]

  @@map("instancias")
}

model Template {
  id              String   @id @default(uuid())
  instanciaId     String   @map("instancia_id")
  nome            String
  metaTemplateId  String   @map("meta_template_id")
  idioma          String   @default("pt_BR")
  // Texto real do corpo aprovado na Meta (com {{1}}, {{2}}...) — usado pra mostrar a
  // mensagem de verdade no histórico de disparos, em vez de só o nome do template.
  corpo           String?
  variaveisSchema Json?    @map("variaveis_schema")
  createdAt       DateTime @default(now()) @map("created_at")

  instancia       Instancia @relation(fields: [instanciaId], references: [id])
  campanhas       CampanhaDiscadora[]

  @@map("templates")
}

model Contato {
  id             String   @id @default(uuid())
  nome           String?
  cpf            String?
  numeroWhatsapp String   @unique @map("numero_whatsapp")
  // Foto de perfil do WhatsApp — só disponível via Evolution API (Baileys/WhatsApp
  // Web); a Meta Cloud API não expõe foto de contato por privacidade. Cacheada
  // porque a URL da Meta/WhatsApp expira; buscarFotoContato() atualiza sob demanda.
  fotoUrl        String?  @map("foto_url")
  fotoAtualizadaEm DateTime? @map("foto_atualizada_em")
  createdAt      DateTime @default(now()) @map("created_at")

  conversas      Conversa[]

  @@map("contatos")
}

model Conversa {
  id            String          @id @default(uuid())
  instanciaId   String          @map("instancia_id")
  contatoId     String          @map("contato_id")
  status        StatusConversa  @default(aberta)
  operadorId    String?         @map("operador_id")
  lastMessageAt DateTime        @default(now()) @map("last_message_at")
  createdAt     DateTime        @default(now()) @map("created_at")
  // Marca permanente de que essa conversa nasceu de um disparo (nunca volta a false) —
  // usada pra exibir a etiqueta azul mesmo depois que o lead responde e vira atendimento.
  origemDisparo Boolean         @default(false) @map("origem_disparo")
  // Vira true no primeiro reply do cliente — é o que tira a conversa da aba "Disparos"
  // e joga pra aba "Atendimento" sem precisar reclassificar origemDisparo.
  respondida    Boolean         @default(true) @map("respondida")
  // true = a Maisa está conduzindo. false = fora dela: sem operadorId fica em
  // "Na fila", com operadorId fica em "Atribuídas".
  comMaisa      Boolean         @default(false) @map("com_maisa")
  convenio      Convenio?
  // "operador" = definido ou removido por uma pessoa: a IA não pode sobrescrever.
  convenioOrigem String?        @map("convenio_origem")
  etapaFunil    EtapaFunil?     @map("etapa_funil")
  // Etapa do fluxo da Maisa e o que ela já sabe. Nunca guarda CPF: ele fica no contato.
  maisaEstado   Json?           @map("maisa_estado")
  // Ofertada pela Maisa e sem resposta do cliente por 24h: aparece no Carrinho para a
  // equipe tentar converter. Sai quando o cliente responde ou alguém tira de lá.
  carrinhoEm    DateTime?       @map("carrinho_em")

  instancia     Instancia  @relation(fields: [instanciaId], references: [id])
  contato       Contato    @relation(fields: [contatoId], references: [id])
  operador      Usuario?   @relation("OperadorConversas", fields: [operadorId], references: [id])
  mensagens     Mensagem[]
  etiquetas     ConversaEtiqueta[]
  visualizacoes ConversaVisualizacao[]
  eventosFunil  FunilEvento[]
  propostas     Proposta[]
  simulacoes    Simulacao[]
  eventosMaisa  MaisaEvento[]

  @@index([carrinhoEm])
  @@map("conversas")
}

model Simulacao {
  id            String             @id @default(uuid())
  conversaId    String             @map("conversa_id")
  operadorId    String?            @map("operador_id")
  banco         String
  convenio      Convenio?
  resultado     ResultadoSimulacao
  valorCentavos Int?               @map("valor_centavos")
  motivo        String?
  createdAt     DateTime           @default(now()) @map("created_at")

  conversa      Conversa           @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  operador      Usuario?           @relation("SimulacoesOperador", fields: [operadorId], references: [id])

  @@index([conversaId])
  @@index([createdAt])
  @@map("simulacoes")
}

model Proposta {
  id              String         @id @default(uuid())
  conversaId      String         @map("conversa_id")
  operadorId      String?        @map("operador_id")
  banco           String
  convenio        Convenio?
  valorCentavos   Int            @map("valor_centavos")
  parcelaCentavos Int?           @map("parcela_centavos")
  prazoMeses      Int?           @map("prazo_meses")
  numeroContrato  String?        @map("numero_contrato")
  status          StatusProposta @default(digitada)
  motivoRecusa    String?        @map("motivo_recusa")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  conversa        Conversa       @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  operador        Usuario?       @relation("PropostasOperador", fields: [operadorId], references: [id])

  @@index([conversaId])
  @@index([status, createdAt])
  @@map("propostas")
}

// Cada passo da Maisa: de qual etapa saiu, para qual foi e o que entendeu.
// Guarda só rótulos, nunca o texto do cliente. Serve para achar onde ela erra.
model MaisaEvento {
  id          String   @id @default(uuid())
  conversaId  String   @map("conversa_id")
  etapaAntes  String?  @map("etapa_antes")
  etapaDepois String   @map("etapa_depois")
  rotulo      String?
  motivo      String?
  createdAt   DateTime @default(now()) @map("created_at")

  conversa    Conversa @relation(fields: [conversaId], references: [id], onDelete: Cascade)

  @@index([conversaId])
  @@index([createdAt])
  @@map("maisa_eventos")
}

// Quando cada conversa chegou em cada etapa do funil.
model FunilEvento {
  id         String     @id @default(uuid())
  conversaId String     @map("conversa_id")
  etapa      EtapaFunil
  createdAt  DateTime   @default(now()) @map("created_at")

  conversa   Conversa   @relation(fields: [conversaId], references: [id], onDelete: Cascade)

  @@unique([conversaId, etapa])
  @@index([etapa, createdAt])
  @@map("funil_eventos")
}

// Quem da equipe já abriu essa conversa desde a última mensagem do cliente —
// zerada (deleteMany) toda vez que chega mensagem nova dele. A bolinha de "não
// respondida" some só pra quem está na lista, mas continua acesa pros colegas
// que ainda não abriram, até alguém responder de verdade.
model ConversaVisualizacao {
  id         String   @id @default(uuid())
  conversaId String   @map("conversa_id")
  usuarioId  String   @map("usuario_id")
  vistoEm    DateTime @default(now()) @map("visto_em")

  conversa   Conversa @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([conversaId, usuarioId])
  @@map("conversa_visualizacoes")
}

model Etiqueta {
  id        String   @id @default(uuid())
  nome      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  conversas ConversaEtiqueta[]

  @@map("etiquetas")
}

model ConversaEtiqueta {
  conversaId String   @map("conversa_id")
  etiquetaId String   @map("etiqueta_id")
  createdAt  DateTime @default(now()) @map("created_at")

  conversa   Conversa @relation(fields: [conversaId], references: [id])
  etiqueta   Etiqueta @relation(fields: [etiquetaId], references: [id])

  @@id([conversaId, etiquetaId])
  @@map("conversa_etiquetas")
}

model Mensagem {
  id            String        @id @default(uuid())
  conversaId    String        @map("conversa_id")
  remetenteTipo RemetenteTipo @map("remetente_tipo")
  operadorId    String?       @map("operador_id")
  conteudoTexto String?       @map("conteudo_texto")
  tipoMidia     String?       @map("tipo_midia")
  midiaPath     String?       @map("midia_path")
  midiaDeleted  Boolean       @default(false) @map("midia_deleted")
  // ID da mensagem no provedor (wamid da Meta, key.id do Baileys/Evolution) — usado pra
  // não duplicar quando o webhook reentrega o mesmo evento (a Meta garante "pelo menos
  // uma vez", não "exatamente uma vez"). Nulo pra mensagens criadas pelo operador/sistema.
  externalId    String?       @unique @map("external_id")
  // Agrupa disparos enviados juntos num CSV em massa (gerado no front, um UUID por
  // lote) — sem isso, um CSV de 50 números vira 50 linhas soltas no histórico.
  loteId        String?       @map("lote_id")
  // Nome do template usado (só disparos) — guardado à parte porque conteudoTexto
  // agora é a mensagem de verdade enviada, não dá mais pra "adivinhar" o template
  // fazendo parsing do texto.
  templateNome  String?       @map("template_nome")
  // Só relevante pra mensagem enviada pelo operador — reflete o status reportado
  // pelo webhook "statuses" da Meta (sent/delivered/read/failed).
  statusEntrega StatusEntrega? @map("status_entrega")
  // Marca quando o operador editou o texto já enviado (só possível via Evolution
  // API) — usado pra mostrar a tag "editada" igual o WhatsApp real.
  editadaEm     DateTime?     @map("editada_em")
  // Motivo real da falha reportado pela Meta/Evolution — gravado no banco porque
  // os logs do container somem a cada deploy/restart (perdíamos o diagnóstico).
  erroEntrega   String?       @map("erro_entrega")
  // Resposta citada (reply do WhatsApp) — aponta pra mensagem original dentro da
  // mesma conversa. Nulo = mensagem normal, sem citação.
  respondeAId   String?       @map("responde_a_id")
  // Resumo da última análise de extrato, sem dado pessoal: aparece no balão do arquivo.
  analiseResumo String?       @map("analise_resumo")
  timestamp     DateTime      @default(now())
  createdAt     DateTime      @default(now()) @map("created_at")

  conversa      Conversa @relation(fields: [conversaId], references: [id])
  operador      Usuario? @relation("OperadorMensagens", fields: [operadorId], references: [id])
  respondeA     Mensagem?  @relation("RespostaMensagem", fields: [respondeAId], references: [id], onDelete: SetNull)
  respostas     Mensagem[] @relation("RespostaMensagem")
  analiseExtrato AnaliseExtrato?

  @@index([loteId])
  @@map("mensagens")
}

model CampanhaDiscadora {
  id                 String          @id @default(uuid())
  nome               String
  audioPath          String          @map("audio_path")
  templateId         String          @map("template_id")
  instanciaId        String          @map("instancia_id")
  status             StatusCampanha  @default(rascunho)
  totalNumeros       Int             @default(0) @map("total_numeros")
  criadoPor          String          @map("criado_por")
  createdAt          DateTime        @default(now()) @map("created_at")

  template           Template        @relation(fields: [templateId], references: [id])
  instancia           Instancia      @relation(fields: [instanciaId], references: [id])
  criador             Usuario        @relation(fields: [criadoPor], references: [id])
  numeros             CampanhaNumero[]

  @@map("campanhas_discadora")
}

model CampanhaNumero {
  id             String        @id @default(uuid())
  campanhaId     String        @map("campanha_id")
  numeroWhatsapp String        @map("numero_whatsapp")
  nomeContato    String?       @map("nome_contato")
  statusLigacao  StatusLigacao @default(pendente) @map("status_ligacao")
  apertou1       Boolean       @default(false) @map("apertou_1")
  hsmDisparado   Boolean       @default(false) @map("hsm_disparado")
  twilioCallSid  String?       @map("twilio_call_sid")
  iniciadoEm     DateTime?     @map("iniciado_em")
  finalizadoEm   DateTime?     @map("finalizado_em")

  campanha       CampanhaDiscadora @relation(fields: [campanhaId], references: [id])

  @@index([campanhaId])
  @@index([twilioCallSid])
  @@map("campanha_numeros")
}

// Foto das métricas num momento. A primeira é a linha de base de antes da Maisa,
// para medir depois quanto ela ajuda nas respostas.
model MetricaRetrato {
  id        String   @id @default(uuid())
  rotulo    String
  dados     Json
  createdAt DateTime @default(now()) @map("created_at")

  @@map("metricas_retratos")
}

// Leitura e análise de um extrato ou contracheque, feita pela Maisa ou pela equipe.
// Guardada para não ler de novo na OpenAI. Apagada junto com o arquivo (regra dos 4 dias).
model AnaliseExtrato {
  mensagemId String   @id @map("mensagem_id")
  dados      Json
  origem     String
  createdAt  DateTime @default(now()) @map("created_at")

  mensagem Mensagem @relation(fields: [mensagemId], references: [id], onDelete: Cascade)

  @@map("analises_extrato")
}

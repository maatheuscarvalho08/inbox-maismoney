# Variáveis usadas pelo docker-compose.prod.yml (Postgres + Evolution API).
# As variáveis do backend em si (JWT_SECRET, META_*, etc.) ficam em backend/.env —
# veja backend/.env.example.

POSTGRES_USER=maismoney
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_DB=maismoney_inbox

# Deve bater com EVOLUTION_API_KEY em backend/.env.
EVOLUTION_API_KEY=troque-por-uma-chave-forte

# URL pública onde a Evolution API vai responder (usada por ela para montar webhooks).
EVOLUTION_SERVER_URL=https://seu-dominio.com/evolution
